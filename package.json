{
  "name": "react-native-app-icon-switcher",
  "version": "0.1.0",
  "description": "Change your React Native app icon at runtime on iOS and Android: while the app runs, from a push notification, or on a schedule, without crashing or closing the app, unlike other icon libraries 🙂. Works on the old and the New Architecture.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "author": "Moksh Upadhyay <mokshupadhyay4@gmail.com>",
  "homepage": "https://github.com/mokshupadhyay/react-native-app-icon-switcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokshupadhyay/react-native-app-icon-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/mokshupadhyay/react-native-app-icon-switcher/issues"
  },
  "files": [
    "src",
    "lib",
    "android/build.gradle",
    "android/src",
    "ios",
    "react-native-app-icon-switcher.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.map"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm test && npm run build",
    "example:install": "npm pack --pack-destination example && cd example && npm install ./react-native-app-icon-switcher-$npm_package_version.tgz",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "react-native",
    "app-icon",
    "app-icon-switcher",
    "change-app-icon",
    "alternate-icon",
    "dynamic-icon",
    "change-icon",
    "launcher-icon",
    "activity-alias",
    "turbo-module",
    "new-architecture"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.71.0"
  },
  "codegenConfig": {
    "name": "RNFlexAppIconSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.flexappicon"
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "jest": "^29.7.0",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "react-test-renderer": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
